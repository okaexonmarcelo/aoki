# Groq — Kimi K2
GROQ_API_KEY=gsk_...

# Oka — API (única base URL y token para todos los endpoints)
# OKA_TOKEN: token temporal de sesión (Cognito), expira pronto.
# Reemplazar por una credencial de servicio cuando el equipo de backend la provea.
OKA_BASE_URL=https://api.dev.oka.com.pe/v1
OKA_TOKEN=pega-aqui-tu-bearer-token

# Servidor
PORT=3000

# CORS — origen permitido (en desarrollo usar *)
CORS_ORIGIN=https://www.oka.com.pe
